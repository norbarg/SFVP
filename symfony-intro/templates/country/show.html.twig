{% extends 'base.html.twig' %}

{% block title %}ATLAS / {{ country.name }}{% endblock %}

{% block body %}
    <section class="page-header">
        <div class="eyebrow">
            ATLAS / COUNTRY
        </div>

        <h1 class="page-title">
            {{ country.name }}
        </h1>

        <p class="page-description">
            Country details and connected travel routes.
        </p>
    </section>

    <div class="detail-card">
        <div class="detail-row">
            <div class="detail-label">
                ID
            </div>

            <div class="detail-value">
                {{ country.id }}
            </div>
        </div>

        <div class="detail-row">
            <div class="detail-label">
                Name
            </div>

            <div class="detail-value">
                {{ country.name }}
            </div>
        </div>

        <div class="detail-row">
            <div class="detail-label">
                Routes
            </div>

            <div class="detail-value">
                {{ country.routes|length }}
            </div>
        </div>
    </div>

    <div class="actions-row">
        <a
            href="{{ path('app_country_index') }}"
            class="btn"
        >
            ← Back
        </a>

        <a
            href="{{ path('app_country_edit', {'id': country.id}) }}"
            class="btn btn-dark"
        >
            Edit
        </a>

        {{ include('country/_delete_form.html.twig') }}
    </div>
{% endblock %}