{% extends 'base.html.twig' %}

{% block title %}ATLAS / Edit Country{% endblock %}

{% block body %}
    <section class="page-header">
        <div class="eyebrow">
            ATLAS / EDIT
        </div>

        <h1 class="page-title">
            EDIT COUNTRY
        </h1>

        <p class="page-description">
            Update the selected country.
        </p>
    </section>

    <div class="form-page">
        {{ include('country/_form.html.twig', {
            'button_label': 'Save changes'
        }) }}

        <div class="actions-row">
            <a
                href="{{ path('app_country_index') }}"
                class="btn"
            >
                ← Back to countries
            </a>

            {{ include('country/_delete_form.html.twig') }}
        </div>
    </div>
{% endblock %}